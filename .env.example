# ─── Server ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/kalyanipura-church

# ─── CORS ─────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Admin Auth ───────────────────────────────────────
ADMIN_EMAIL=admin@kalyanipurachurch.org
ADMIN_PASSWORD=ChangeMe123!
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# ─── Rate Limiting ────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── Logging ──────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=logs
