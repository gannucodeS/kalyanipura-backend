<%- include('../partials/header') %>
<%- include('../partials/sidebar', { active: 'events' }) %>
<div class="main-content">
  <div class="top-bar">
    <h1><%= item._id ? 'Edit' : 'New' %> Event</h1>
    <div class="admin-info">
      <span><%= email %></span>
      <form action="/admin/logout" method="POST"><button class="btn btn-outline btn-sm">Logout</button></form>
    </div>
  </div>
  <% if (locals.error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <div class="card">
    <form action="/admin/events<%= item._id ? '/' + item._id + '/edit' : '/new' %>" method="POST">
      <div class="form-group"><label>Title</label><input type="text" name="title" class="input" value="<%= item.title || '' %>" required></div>
      <div class="form-group"><label>Day</label><input type="text" name="day" class="input" value="<%= item.day || '' %>" maxlength="2" required></div>
      <div class="form-group"><label>Month (3-letter)</label><input type="text" name="month" class="input" value="<%= item.month || '' %>" maxlength="3" required></div>
      <div class="form-group"><label>Time</label><input type="text" name="time" class="input" value="<%= item.time || '' %>" required></div>
      <div class="form-group"><label>Location</label><input type="text" name="location" class="input" value="<%= item.location || '' %>" required></div>
      <div class="form-group"><label>Description</label><textarea name="description" class="input" rows="4" required><%= item.description || '' %></textarea></div>
      <div class="form-group"><label>RSVP Count</label><input type="number" name="rsvpCount" class="input" value="<%= item.rsvpCount || 0 %>" min="0"></div>
      <div class="modal-actions">
        <a href="/admin/events" class="btn btn-outline">Cancel</a>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
