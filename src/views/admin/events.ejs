<%- include('../partials/header') %>
<%- include('../partials/sidebar', { active: 'events' }) %>
<div class="main-content">
  <div class="top-bar">
    <h1>Events</h1>
    <div class="admin-info">
      <span><%= email %></span>
      <form action="/admin/logout" method="POST"><button class="btn btn-outline btn-sm">Logout</button></form>
      <a href="/admin/events/new" class="btn btn-primary">+ New</a>
    </div>
  </div>
  <% if (locals.success) { %><div class="alert alert-success"><%= success %></div><% } %>
  <div class="card">
    <table>
      <thead><tr><th>Title</th><th>Date</th><th>Time</th><th>Location</th><th>RSVPs</th><th>Actions</th></tr></thead>
      <tbody>
        <% if (items.length === 0) { %><tr><td colspan="6" class="empty-state">No events found.</td></tr><% } %>
        <% items.forEach(item => { %>
          <tr>
            <td><%= item.title %></td>
            <td><%= item.month %> <%= item.day %></td>
            <td><%= item.time %></td>
            <td class="text-muted"><%= item.location %></td>
            <td><%= item.rsvpCount %></td>
            <td>
              <div class="actions">
                <a href="/admin/events/<%= item._id %>/edit" class="btn btn-outline btn-sm">Edit</a>
                <a href="/admin/events/<%= item._id %>/delete" class="btn btn-danger btn-sm" onclick="return confirm('Delete?')">Delete</a>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
