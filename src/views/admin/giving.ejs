<%- include('../partials/header') %>
<%- include('../partials/sidebar', { active: 'giving' }) %>
<div class="main-content">
  <div class="top-bar">
    <h1>Giving Records</h1>
    <div class="admin-info">
      <span><%= email %></span>
      <form action="/admin/logout" method="POST"><button class="btn btn-outline btn-sm">Logout</button></form>
    </div>
  </div>
  <div class="card">
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Amount</th>
          <th>Frequency</th>
          <th>Date</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (records.length === 0) { %>
          <tr><td colspan="6" class="empty-state">No giving records found.</td></tr>
        <% } %>
        <% records.forEach(g => { %>
          <tr>
            <td><%= g.name %></td>
            <td><%= g.email %></td>
            <td><strong>₹<%= g.amount %></strong></td>
            <td><span class="tag"><%= g.frequency %></span></td>
            <td class="text-muted"><%= new Date(g.createdAt).toLocaleDateString() %></td>
            <td><a href="/admin/giving/<%= g._id %>/delete" class="btn btn-danger btn-sm" onclick="return confirm('Delete?')">Delete</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <% if (pagination.pages > 1) { %>
      <div class="pagination">
        <% if (pagination.hasPrev) { %><a href="?page=<%= pagination.page - 1 %>">&laquo; Prev</a><% } %>
        <% for (let i = 1; i <= pagination.pages; i++) { %>
          <a href="?page=<%= i %>" class="<%= i === pagination.page ? 'active' : '' %>"><%= i %></a>
        <% } %>
        <% if (pagination.hasNext) { %><a href="?page=<%= pagination.page + 1 %>">Next &raquo;</a><% } %>
      </div>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
