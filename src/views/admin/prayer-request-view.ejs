<%- include('../partials/header') %>
<%- include('../partials/sidebar', { active: 'prayer-requests' }) %>
<div class="main-content">
  <div class="top-bar">
    <h1>Prayer Request Details</h1>
    <div class="admin-info">
      <span><%= email %></span>
      <form action="/admin/logout" method="POST"><button class="btn btn-outline btn-sm">Logout</button></form>
    </div>
  </div>
  <div class="card">
    <div class="form-group"><label>Name</label><div><%= r.name %></div></div>
    <div class="form-group"><label>Category</label><div><span class="tag"><%= r.category %></span></div></div>
    <div class="form-group"><label>Request (EN)</label><pre><%= r.request %></pre></div>
    <div class="form-group"><label>Request (HI)</label><pre><%= r.requestHi || '(not translated)' %></pre></div>
    <div class="form-group"><label>Anonymous</label><div><%= r.isAnonymous ? 'Yes' : 'No' %></div></div>
    <div class="form-group"><label>Prayed Count</label><div><%= r.prayedCount %></div></div>
    <div class="form-group"><label>Approved</label><div><%= r.isApproved ? 'Yes' : 'No' %></div></div>
    <div class="form-group"><label>Submitted</label><div><%= new Date(r.createdAt).toLocaleString() %></div></div>
    <div class="modal-actions">
      <a href="/admin/prayer-requests" class="btn btn-outline">Back</a>
      <% if (!r.isApproved) { %><a href="/admin/prayer-requests/<%= r._id %>/approve" class="btn btn-success">Approve</a><% } %>
      <a href="/admin/prayer-requests/<%= r._id %>/delete" class="btn btn-danger" onclick="return confirm('Delete?')">Delete</a>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
