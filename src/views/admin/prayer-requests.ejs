<%- include('../partials/header') %>
<%- include('../partials/sidebar', { active: 'prayer-requests' }) %>
<div class="main-content">
  <div class="top-bar">
    <h1>Prayer Requests</h1>
    <div class="admin-info">
      <span><%= email %></span>
      <form action="/admin/logout" method="POST"><button class="btn btn-outline btn-sm">Logout</button></form>
    </div>
  </div>
  <% if (locals.success) { %><div class="alert alert-success"><%= success %></div><% } %>
  <div class="actions" style="margin-bottom: 1rem;">
    <a href="/admin/prayer-requests/backfill-translations" class="btn btn-outline btn-sm">Backfill Hindi Translations</a>
  </div>
  <div class="card">
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Category</th>
          <th>Request</th>
          <th>Prayed</th>
          <th>Approved</th>
          <th>Date</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (requests.length === 0) { %>
          <tr><td colspan="7" class="empty-state">No prayer requests found.</td></tr>
        <% } %>
        <% requests.forEach(r => { %>
          <tr>
            <td><%= r.name %></td>
            <td><span class="tag"><%= r.category %></span></td>
            <td style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= r.request %></td>
            <td><%= r.prayedCount %></td>
            <td><%= r.isApproved ? 'Yes' : 'No' %></td>
            <td class="text-muted"><%= new Date(r.createdAt).toLocaleDateString() %></td>
            <td>
              <div class="actions">
                <a href="/admin/prayer-requests/<%= r._id %>/view" class="btn btn-outline btn-sm">View</a>
                <% if (!r.isApproved) { %>
                  <a href="/admin/prayer-requests/<%= r._id %>/approve" class="btn btn-success btn-sm">Approve</a>
                <% } %>
                <a href="/admin/prayer-requests/<%= r._id %>/delete" class="btn btn-danger btn-sm" onclick="return confirm('Delete this prayer request?')">Delete</a>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <% if (pagination.pages > 1) { %>
      <div class="pagination">
        <% if (pagination.hasPrev) { %><a href="?page=<%= pagination.page - 1 %>">&laquo; Prev</a><% } %>
        <% for (let i = 1; i <= pagination.pages; i++) { %>
          <a href="?page=<%= i %>" class="<%= i === pagination.page ? 'active' : '' %>"><%= i %></a>
        <% } %>
        <% if (pagination.hasNext) { %><a href="?page=<%= pagination.page + 1 %>">Next &raquo;</a><% } %>
      </div>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
