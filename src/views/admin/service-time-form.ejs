<%- include('../partials/header') %>
<%- include('../partials/sidebar', { active: 'service-times' }) %>
<div class="main-content">
  <div class="top-bar">
    <h1><%= item._id ? 'Edit' : 'New' %> Service Time</h1>
    <div class="admin-info">
      <span><%= email %></span>
      <form action="/admin/logout" method="POST"><button class="btn btn-outline btn-sm">Logout</button></form>
    </div>
  </div>
  <% if (locals.error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <div class="card">
    <form action="/admin/service-times<%= item._id ? '/' + item._id + '/edit' : '/new' %>" method="POST">
      <div class="form-group">
        <label>Title</label>
        <input type="text" name="title" class="input" value="<%= item.title || '' %>" required>
      </div>
      <div class="form-group">
        <label>Time</label>
        <input type="text" name="time" class="input" value="<%= item.time || '' %>" required>
      </div>
      <div class="form-group">
        <label>Tagline</label>
        <input type="text" name="tagline" class="input" value="<%= item.tagline || '' %>" required>
      </div>
      <div class="form-group">
        <label>Category</label>
        <input type="text" name="category" class="input" value="<%= item.category || '' %>" required>
      </div>
      <div class="form-group">
        <label>Icon</label>
        <select name="icon" class="input" required>
          <option value="sun" <%= item.icon === 'sun' ? 'selected' : '' %>>Sun</option>
          <option value="moon" <%= item.icon === 'moon' ? 'selected' : '' %>>Moon</option>
          <option value="users" <%= item.icon === 'users' ? 'selected' : '' %>>Users</option>
        </select>
      </div>
      <div class="modal-actions">
        <a href="/admin/service-times" class="btn btn-outline">Cancel</a>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
