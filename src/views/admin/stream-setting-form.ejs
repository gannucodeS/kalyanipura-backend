<%- include('../partials/header') %>
<%- include('../partials/sidebar', { active: 'stream-settings' }) %>
<div class="main-content">
  <div class="top-bar">
    <h1>Edit Stream Settings</h1>
    <div class="admin-info">
      <span><%= email %></span>
      <form action="/admin/logout" method="POST"><button class="btn btn-outline btn-sm">Logout</button></form>
    </div>
  </div>
  <div class="card">
    <form action="/admin/stream-settings/<%= setting._id %>/edit" method="POST">
      <div class="form-group">
        <label for="youtubeUrl">YouTube URL</label>
        <input type="url" id="youtubeUrl" name="youtubeUrl" value="<%= setting.youtubeUrl %>" class="form-control" placeholder="https://youtube.com/..." />
      </div>
      <div class="form-group">
        <label for="churchPlatformUrl">Church Online Platform URL</label>
        <input type="url" id="churchPlatformUrl" name="churchPlatformUrl" value="<%= setting.churchPlatformUrl %>" class="form-control" placeholder="https://..." />
      </div>
      <div class="form-group">
        <label class="checkbox-label">
          <input type="checkbox" name="isLive" <%= setting.isLive ? 'checked' : '' %> />
          Live Now (show red badge)
        </label>
      </div>
      <div class="form-group">
        <label for="serviceTimes">Service Times (English)</label>
        <input type="text" id="serviceTimes" name="serviceTimes" value="<%= setting.serviceTimes %>" class="form-control" />
      </div>
      <div class="form-group">
        <label for="serviceTimesHi">Service Times (Hindi)</label>
        <input type="text" id="serviceTimesHi" name="serviceTimesHi" value="<%= setting.serviceTimesHi %>" class="form-control" />
      </div>
      <div class="modal-actions">
        <a href="/admin/stream-settings" class="btn btn-outline">Cancel</a>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>