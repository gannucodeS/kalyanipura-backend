<%- include('../partials/header') %>
<%- include('../partials/sidebar', { active: 'zoom-meetings' }) %>
<div class="main-content">
  <div class="top-bar">
    <h1>Zoom Meeting</h1>
    <div class="admin-info">
      <span><%= email %></span>
      <form action="/admin/logout" method="POST"><button class="btn btn-outline btn-sm">Logout</button></form>
    </div>
  </div>
  <% if (locals.success) { %><div class="alert alert-success"><%= success %></div><% } %>
  <% if (!meeting) { %>
    <div class="card">
      <p class="text-muted">No meeting configured yet.</p>
    </div>
  <% } else { %>
    <div class="card">
      <div class="form-group"><label>Title</label><div><%= meeting.title %></div></div>
      <div class="form-group"><label>Description</label><div><%= meeting.description %></div></div>
      <div class="form-group"><label>Date</label><div><%= meeting.date ? new Date(meeting.date).toLocaleDateString() : 'Not set' %></div></div>
      <div class="form-group"><label>Time</label><div><%= meeting.time %></div></div>
      <div class="form-group"><label>Timezone</label><div><%= meeting.timeZone %></div></div>
      <div class="form-group"><label>Join URL</label><div style="word-break:break-all"><%= meeting.joinUrl || '(not set)' %></div></div>
      <div class="form-group"><label>Status</label><div><%= meeting.isActive ? 'Active' : 'Inactive' %></div></div>
      <div class="modal-actions">
        <a href="/admin/zoom-meetings/<%= meeting._id %>/edit" class="btn btn-primary">Edit</a>
        <a href="/admin/zoom-meetings/<%= meeting._id %>/toggle" class="btn btn-outline"><%= meeting.isActive ? 'Deactivate' : 'Activate' %></a>
      </div>
    </div>
  <% } %>
</div>
<%- include('../partials/footer') %>